#!/usr/bin/env bash
# Recarrega UMA extensão do GNOME, sem reiniciar o shell.
#
# POR QUE ISTO EXISTE
#
# Em X11, `Alt+F2` → `r` reinicia o gnome-shell no lugar, e é assim que se vê uma
# mudança em extensão. **Em Wayland esse atalho não existe**: o shell é o próprio
# compositor, e reiniciá-lo derrubaria a sessão. O diálogo trata o `r` como um
# programa qualquer e responde `command not found`.
#
# Mas na prática ninguém quer reiniciar o shell — quer recarregar a extensão que
# acabou de editar. Isso o Wayland permite: desabilitar e reabilitar faz o shell
# descartar o módulo e reler o arquivo do disco.
#
# Instalado como `/usr/local/bin/r`, devolve o gesto `Alt+F2` → `r` → Enter.
#
# UMA SÓ, E POR QUE
#
# A primeira versão recarregava todas as extensões habilitadas. **Isso quebrou a
# sessão inteira** (2026-08-24): extensões que fazem monkey-patch no shell — o
# `ding`, o `dash-to-dock`, o `hanabi` — guardam a função original para restaurar
# no disable. Derrubando várias fora de ordem, uma restaura por cima da outra, a
# cadeia se perde (`replaceData.old_get_window_actors is undefined`) e **cinco
# extensões caíram em ERROR de uma vez**. Extensão em ERROR não volta com
# `enable`: o shell não a reimporta. Só reiniciando o shell — ou seja, deslogando.
#
# Daí a regra: uma por vez, e por padrão só a deste repo.
#
# O QUE ELE NÃO FAZ: recarregar o código do próprio shell. Mudou algo fora de uma
# extensão? Deslogar e logar, não tem atalho.
set -euo pipefail

UUID="${1:-battlog@victor}"

if [ "$UUID" = "--help" ] || [ "$UUID" = "-h" ]; then
  echo "uso: r [uuid]        (padrão: battlog@victor)"
  echo "recarrega UMA extensão do GNOME sem reiniciar o shell."
  exit 0
fi

if ! gnome-extensions info "$UUID" >/dev/null 2>&1; then
  echo "não existe extensão '$UUID'"; exit 1
fi

estado() { gnome-extensions info "$UUID" 2>/dev/null | sed -n 's/^ *State: *//p'; }

ANTES=$(estado)
if [ "$ANTES" = "ERROR" ]; then
  # Recarregar não tira dali, e insistir só confunde quem está diagnosticando.
  echo "$UUID está em ERROR — recarregar não resolve."
  echo "O shell não reimporta extensão em ERROR: é preciso deslogar e logar."
  echo "Veja a causa com:  journalctl --user -b | grep -A8 '$UUID'"
  exit 1
fi

gnome-extensions disable "$UUID"
# O shell processa disable/enable no seu próprio laço; sem a pausa ele às vezes
# junta os dois e a extensão não chega a ser descarregada.
sleep 0.5
gnome-extensions enable "$UUID"
sleep 0.5

DEPOIS=$(estado)
echo "$UUID: $ANTES -> $DEPOIS"

# O Alt+F2 não mostra stdout — sem a notificação o comando parece mudo.
if command -v notify-send >/dev/null; then
  if [ "$DEPOIS" = "ACTIVE" ]; then
    notify-send -t 2500 "GNOME" "$UUID recarregada"
  else
    notify-send -u critical -t 5000 "GNOME" "$UUID -> $DEPOIS (veja o journal)"
  fi
fi

[ "$DEPOIS" = "ACTIVE" ]
