#!/usr/bin/env python3
"""kmctl — bateria e controle dos periféricos, um comando só.

Ele não sabe nada de modelo nenhum: pergunta ao `devices/` quem está plugado e
oferece o que cada modelo declarar em CAPS. Um modelo novo aparece aqui sozinho
no instante em que o diretório dele existe.

    kmctl devices                  quem é suportado, quem está plugado
    kmctl scan                     este aparelho vai aparecer? e se não, por quê
    kmctl dump                     despeja TUDO de um aparelho novo, para colar
    kmctl battery                  percentual agora (leitura ao vivo)
    kmctl probe                    grava uma rodada no histórico (é o do cron)
    kmctl watch                    fica lendo e atualizando o painel (é o serviço)
    kmctl show                     timeline
    kmctl raw                      quais bytes variaram (achar bateria nova)
    kmctl status                   o cache que o painel lê
    kmctl light --mode 7           iluminação (se o modelo fizer)
    kmctl rgb 00ff80 [--only ...]  cor (o que --only seleciona é do modelo)
    kmctl off                      apaga as teclas
    kmctl key z printscreen        remap
    kmctl sleep never              tempo até dormir
    kmctl modes                    modos de luz do modelo
    kmctl selftest                 checa o repo inteiro (não precisa hardware)
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import battery  # noqa: E402
import devices  # noqa: E402


def escolher(args, cap=None):
    """(módulo, handle) do que operar. Erra com mensagem útil.

    `--device` aceita **o que o `kmctl devices` mostra** — o ident. Aceita também
    o id do módulo, que é o que permite `--dry-run` contra hardware ausente. Os
    dois vocabulários coincidiam por acidente enquanto todo aparelho vinha de um
    diretório de modelo; com fontes genéricas o ident é `bt_...` e só o primeiro
    caminho funciona.

    Sem `--device`, opera quem está aqui **e declara a cap**, de qualquer
    categoria. Antes o despacho era fixo em teclado, porque no começo só o
    teclado tinha o que controlar.
    """
    if args.device:
        # id de módulo primeiro, e sem varrer nada: é o que faz
        # `--device <modelo> --dry-run` funcionar sem hardware sem pagar por uma
        # descoberta que não usaria (glob de hidraw + fork de `busctl`).
        for mod in devices.modules():
            if mod.ID != args.device:
                continue
            if not getattr(mod, "SOURCE", False):
                return mod, mod.find()
            seus = [f for f in devices.present() if f.mod is mod]
            if len(seus) == 1:
                return seus[0].mod, seus[0].handle
            if not seus:
                return mod, None
            # uma fonte acha vários, e o id dela é o mesmo para todos: escolher
            # o primeiro em silêncio seria pior que pedir o ident
            quais = ", ".join(f.ident for f in seus)
            sys.exit(f"`{args.device}` achou mais de um aparelho ({quais}) — "
                     "escolha um pelo ident em --device")
        for f in devices.present():
            if f.ident == args.device:
                return f.mod, f.handle
        sys.exit(f"não conheço {args.device!r} — veja `kmctl devices`")
    achados = devices.present()
    if cap:
        fazem = [f for f in achados if cap in f.mod.CAPS]
        if len(fazem) == 1:
            return fazem[0].mod, fazem[0].handle
        if len(fazem) > 1:
            quais = ", ".join(f.ident for f in fazem)
            sys.exit(f"mais de um aqui faz `{cap}` ({quais}) — "
                     "escolha com --device <ident>")
        # Ninguém faz: devolve quem sabe *dizer por que não*, para a mensagem de
        # WONT valer mais que um "nenhum plugado" genérico. É o caso do K86, que
        # explica em uma frase por que não há RGB por 2.4G.
        for f in achados:
            if cap in getattr(f.mod, "WONT", {}):
                return f.mod, f.handle
    if achados:
        return achados[0].mod, achados[0].handle
    sys.exit("nada com bateria aqui. Use --device <id> para operar em modo "
             "--dry-run mesmo sem o hardware.")


def operar(args, cap, **kw):
    """Despacha uma operação de controle, respeitando CAPS e WONT."""
    mod, path = escolher(args, cap)
    if cap not in mod.CAPS:
        motivo = getattr(mod, "WONT", {}).get(cap)
        if motivo:
            sys.exit(f"{mod.NAME} não faz `{cap}`: {motivo}")
        sys.exit(f"{mod.NAME} não faz `{cap}` (CAPS: {', '.join(mod.CAPS)})")
    if path is None and not args.dry_run:
        sys.exit(f"{mod.NAME} não está plugado")
    try:
        msg, log = getattr(mod, cap)(path, dry=args.dry_run, **kw)
    except ValueError as e:
        sys.exit(str(e))
    if args.dry_run or args.verbose:
        print("\n".join(log))
    print(("[dry-run] " if args.dry_run else "") + msg)
    return 0


def cmd_devices(args):
    achados = devices.present()
    print("aqui agora (é o que o painel mostra; o ident vai em --device):")
    if not achados:
        print("  nada com bateria")
    for f in achados:
        print(f"  {f.ident:22} {f.name:24} {f.kind:9} {f.handle}")
    print()
    print("módulos:")
    plugados = {f.mod.ID for f in achados}
    print(f"  {'id':22} {'tipo':7} {'estado':9} {'categoria':10} caps")
    for mod in devices.modules():
        fonte = getattr(mod, "SOURCE", False)
        estado = "ativo" if mod.ID in plugados else "-"
        print(f"  {mod.ID:22} {'fonte' if fonte else 'modelo':7} {estado:9} "
              f"{'(vários)' if fonte else mod.KIND:10} {', '.join(mod.CAPS)}")
    return 0


def cmd_scan(args):
    import scan
    linhas = scan.varrer()
    if not linhas:
        print("nenhum periférico HID nem Bluetooth encontrado")
        return 0
    largura = max(len(n) for n, _, _ in linhas)
    for nome, detalhe, veredito in linhas:
        print(f"{nome:{largura}}  {detalhe}")
        print(f"{'':{largura}}  -> {veredito}")
    print()
    print("Quatro caminhos para a bateria aparecer, em ordem de sorte:")
    print("  1. Bluetooth        — sozinho, se o firmware reportar")
    print("  2. bateria no HID   — sozinho, o kernel cria o power_supply")
    print("  3. família conhecida — sozinho, pela sonda (hoje: Delux/TeLink 0x0c)")
    print("  4. fabricante novo  — só com um diretório em devices/, ou seja")
    print("                        engenharia reversa (veja devices/README.md)")
    return 0


def cmd_battery(args):
    achados = devices.present()
    if args.device:
        achados = [f for f in achados
                   if args.device in (f.ident, f.mod.ID)]
        if not achados:
            sys.exit(f"{args.device!r} não está aqui — veja `kmctl devices`")
    if not achados:
        print("nada com bateria aqui")
        return 0
    for f in achados:
        r = f.mod.battery(f.handle, args.wait)
        if r is None:
            print(f"{f.kind:9} —  ({f.name} não respondeu em {args.wait:.0f}s)")
            continue
        carga = " carregando" if r.charging else ""
        print(f"{f.kind:9} {r.pct}%{carga}  ({f.name})")
    return 0


def cmd_modes(args):
    mod, _ = escolher(args)
    modos = getattr(mod, "MODES", None)
    if not modos:
        sys.exit(f"{mod.NAME} não declara modos de iluminação")
    for n, nome in sorted(modos.items()):
        print(f"  {n:2}  {nome}")
    return 0


def main():
    ap = argparse.ArgumentParser(
        description=__doc__.splitlines()[0],
        formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    ap.add_argument("--device", help="opera num aparelho específico: o ident do "
                                    "`kmctl devices`, ou o id de um módulo para "
                                    "--dry-run sem hardware")
    ap.add_argument("--dry-run", action="store_true",
                    help="monta os pacotes e mostra, sem abrir o dispositivo")
    ap.add_argument("-v", "--verbose", action="store_true", help="mostra os pacotes")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("devices", help="modelos suportados e quem está plugado")
    sub.add_parser("scan", help="diagnóstico: por que um aparelho não aparece")
    dp = sub.add_parser("dump", help="despeja tudo de um aparelho novo (para colar)")
    dp.add_argument("--seconds", type=float, default=20,
                    help="segundos de escuta dos canais (default: 20). USE o "
                         "aparelho durante, senão o silêncio não diz nada")
    ba = sub.add_parser("battery", help="percentual agora (leitura ao vivo)")
    ba.add_argument("--wait", type=float, default=5,
                    help="segundos esperando o mouse se anunciar (default: 5)")
    wt = sub.add_parser("watch", help="loop que mantém o painel em dia (serviço)")
    wt.add_argument("--interval", type=float, default=20,
                    help="segundos entre releituras quando nada acontece "
                         "(default: 20). Despertador de udev/BlueZ fura isso e "
                         "reage na hora")
    wt.add_argument("--record", type=float, default=600,
                    help="segundos entre amostras no histórico (default: 600). "
                         "Gravar a cada leitura encheria o banco sem dizer nada")
    wt.add_argument("--wait", type=float, default=3,
                    help="segundos esperando cada aparelho de ANÚNCIO se "
                         "anunciar (default: 3). Zero torna invisível todo "
                         "modelo que não responde a pergunta — M900Pro, AJ139, "
                         "F75")
    wt.add_argument("--heartbeat", type=float, default=300,
                    help="segundos entre gravações do cache mesmo sem mudança "
                         "(default: 300). É o batimento que diz ao painel que "
                         "o serviço está vivo; sem ele o painel mostraria "
                         "número velho como atual")
    wt.add_argument("--keep", type=int, default=battery.KEEP_DAYS,
                    help=f"dias de histórico (default: {battery.KEEP_DAYS})")
    pr = sub.add_parser("probe", help="grava uma rodada no histórico (cron)")
    pr.add_argument("--wait", type=float, default=60)
    pr.add_argument("--keep", type=int, default=battery.KEEP_DAYS,
                    help=f"dias de histórico (default: {battery.KEEP_DAYS})")
    rw = sub.add_parser("raw", help="quais bytes variaram e como")
    rw.add_argument("--days", type=float, default=7)
    sh = sub.add_parser("show", help="timeline de bateria")
    sh.add_argument("--days", type=float, default=7)
    sh.add_argument("--width", type=int, default=60)
    sub.add_parser("status", help="o cache que o painel lê")
    li = sub.add_parser("light", help="modo de iluminação")
    li.add_argument("--mode", type=int, default=7)
    li.add_argument("--brightness", type=int, default=5)
    li.add_argument("--speed", type=int, default=3)
    li.add_argument("--direction", type=int, default=0)
    li.add_argument("--color", type=int, default=0, help="índice da paleta do firmware")
    rg = sub.add_parser("rgb", help="cor RGB arbitrária")
    rg.add_argument("color", help="RRGGBB, ex: ff0080")
    rg.add_argument("--only", help="o que pintar; depende do modelo — teclas "
                                   "no F75 (esc,f1,a), estágios de DPI no "
                                   "M800 PRO (1,3)")
    rg.add_argument("--brightness", type=int, default=5)
    rg.add_argument("--speed", type=int, default=4)
    sub.add_parser("off", help="apaga as teclas")
    ky = sub.add_parser("key", help="remapeia uma tecla")
    ky.add_argument("key")
    ky.add_argument("to")
    ky.add_argument("--layer", default="fn", choices=("base", "fn"))
    sl = sub.add_parser("sleep", help="tempo até o teclado dormir")
    sl.add_argument("when")
    sub.add_parser("modes", help="modos de iluminação do modelo")
    sub.add_parser("selftest", help="checa o repo inteiro")
    args = ap.parse_args()

    if args.cmd == "selftest":
        import selftest
        return selftest.main()
    if args.cmd == "devices":
        return cmd_devices(args)
    if args.cmd == "scan":
        return cmd_scan(args)
    if args.cmd == "dump":
        import dump
        return dump.relatorio(args.seconds)
    if args.cmd == "battery":
        return cmd_battery(args)
    if args.cmd == "modes":
        return cmd_modes(args)
    if args.cmd == "probe":
        return 0 if battery.probe(args.wait, args.keep) else 1
    if args.cmd == "watch":
        return battery.watch(args.interval, args.record, args.heartbeat,
                             args.wait, keep=args.keep)
    if args.cmd == "status":
        con = battery.db_open()
        # uma descoberta só: imprimir o que foi gravado, não uma segunda leitura
        # que um aparelho saindo no meio faria discordar do arquivo
        texto = battery.status_text(con, devices.present())
        battery.write_status(con, texto=texto)
        print(texto, end="")
        return 0
    if args.cmd == "raw":
        battery.report_raw(battery.db_open(), args.days)
        return 0
    if args.cmd == "show":
        return battery.report_show(battery.db_open(), args.days, args.width)
    if args.cmd == "light":
        return operar(args, "light", mode=args.mode, brightness=args.brightness,
                      speed=args.speed, direction=args.direction, color=args.color)
    if args.cmd == "rgb":
        return operar(args, "rgb", color=args.color, only=args.only,
                      brightness=args.brightness, speed=args.speed)
    if args.cmd == "off":
        return operar(args, "off")
    if args.cmd == "key":
        return operar(args, "remap", key=args.key, to=args.to, layer=args.layer)
    if args.cmd == "sleep":
        return operar(args, "sleep", when=args.when)
    ap.error(f"comando não tratado: {args.cmd}")


if __name__ == "__main__":
    sys.exit(main() or 0)
